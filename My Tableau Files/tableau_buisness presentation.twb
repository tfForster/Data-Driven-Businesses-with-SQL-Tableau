          <filter class='categorical' column='[federated.1pilbgy104do8a176tywh1gdrqdh].[none:Calculation_1783708419801088:nk]'>
            <groupfilter function='member' level='[none:Calculation_1783708419801088:nk]' member='&quot;tech_product&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
