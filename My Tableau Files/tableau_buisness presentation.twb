              <calculation class='tableau' formula='IF [product_category_name_english]IN (    &#13;&#10;    &apos;electronics&apos;,&#13;&#10;    &apos;computers&apos;,&#13;&#10;    &apos;computers_accessories&apos;,&#13;&#10;    &apos;telephony&apos;,&#13;&#10;    &apos;fixed_telephony&apos;,&#13;&#10;    &apos;cine_photo&apos;,&#13;&#10;    &apos;pc_gamer&apos;,&#13;&#10;    &apos;consoles_games&apos;,&#13;&#10;    &apos;cds_dvds_musicals&apos;,&#13;&#10;    &apos;dvds_blu_ray&apos;,&#13;&#10;    &apos;audio&apos;,&#13;&#10;    &apos;auto&apos;&#13;&#10;) &#13;&#10;THEN &apos;tech_product&apos; &#13;&#10;ELSE &apos;non_tech&apos; &#13;&#10;END' />
