            <column caption='price_category' datatype='string' name='[Calculation_1783708422049793]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [price] &gt; 100 THEN &apos;expensive&apos; ELSE &apos;non_expensive&apos; END' />
            </column>
            <column caption='peak_label' datatype='integer' name='[Calculation_1783708435111938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;    INDEX() = 1&#13;&#10;    OR INDEX() = SIZE()&#13;&#10;    OR (&#13;&#10;        COUNT([product_id (products.csv)]) &gt; LOOKUP(COUNT([product_id (products.csv)]), -1)&#13;&#10;        AND COUNT([product_id (products.csv)]) &gt; LOOKUP(COUNT([product_id (products.csv)]), 1)&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    COUNT([product_id (products.csv)])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
