      <column caption='categorie' datatype='string' name='[Calculation_1783708419801088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [product_category_name_english]IN (    &#13;&#10;    &apos;electronics&apos;,&#13;&#10;    &apos;computers&apos;,&#13;&#10;    &apos;computers_accessories&apos;,&#13;&#10;    &apos;telephony&apos;,&#13;&#10;    &apos;fixed_telephony&apos;,&#13;&#10;    &apos;cine_photo&apos;,&#13;&#10;    &apos;pc_gamer&apos;,&#13;&#10;    &apos;consoles_games&apos;,&#13;&#10;    &apos;cds_dvds_musicals&apos;,&#13;&#10;    &apos;dvds_blu_ray&apos;,&#13;&#10;    &apos;audio&apos;,&#13;&#10;    &apos;auto&apos;&#13;&#10;) &#13;&#10;THEN &apos;tech_product&apos; &#13;&#10;ELSE &apos;non_tech&apos; &#13;&#10;END' />
      </column>
      <column caption='price_category' datatype='string' name='[Calculation_1783708422049793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [price] &gt; 100 THEN &apos;expensive&apos; ELSE &apos;non_expensive&apos; END' />
      </column>
      <column caption='peak_label' datatype='integer' name='[Calculation_1783708435111938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#13;&#10;    INDEX() = 1&#13;&#10;    OR INDEX() = SIZE()&#13;&#10;    OR (&#13;&#10;        COUNT([product_id (products.csv)]) &gt; LOOKUP(COUNT([product_id (products.csv)]), -1)&#13;&#10;        AND COUNT([product_id (products.csv)]) &gt; LOOKUP(COUNT([product_id (products.csv)]), 1)&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    COUNT([product_id (products.csv)])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='End_Label' datatype='string' name='[Calculation_1783708456058883]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF INDEX() = SIZE() THEN&#13;&#10;    ATTR([Calculation_1783708422049793])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
