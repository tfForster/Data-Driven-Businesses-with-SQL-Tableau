            <column caption='End_Label' datatype='string' name='[Calculation_1783708456058883]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF INDEX() = SIZE() THEN&#13;&#10;    ATTR([Calculation_1783708422049793])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
